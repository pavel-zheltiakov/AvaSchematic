<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--
      nuget.org and nothing else. The demo gets AvaSchematic the same way your own project will, which is
      the point: if the published package is broken, this build says so instead of quietly resolving a copy
      committed next to it. <clear /> is here so a machine-wide source cannot substitute a different one.
    -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
